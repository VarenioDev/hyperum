# PostgreSQL
HYPERUM_DB_URL=postgresql://hyperum:CHANGE_ME@localhost:5432/hyperum

# Neo4j
HYPERUM_NEO4J_URI=bolt://localhost:7687
HYPERUM_NEO4J_USER=neo4j
HYPERUM_NEO4J_PASSWORD=CHANGE_ME

# JWT — сгенерируй через `openssl rand -hex 32`
HYPERUM_JWT_SECRET=CHANGE_ME

# Tenant по умолчанию
HYPERUM_TENANT_DEFAULT=school_lyceum

# LLM API
GIGACHAT_AUTH_KEY=your_gigachat_key
DEEPSEEK_API_KEY=sk-your_deepseek_key