# ─── Python ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Node / PWA ─────────────────────────────────────
node_modules/
pwa/dist/
pwa/dev-dist/
pwa/.vite/
pwa/.turbo/
npm-debug.log*
