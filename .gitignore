*.dump
*.sql.gz
*.sql.bak
backup.sql
dump.sql

# Миграции — оставляем!
!migrations/*.sql
!sql/**/*.sql
*.dump
backup/
backups/

# ─── Логи ──────────────────────────────────────────
*.log
logs/

# ─── IDE ───────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ─── OS ────────────────────────────────────────────
