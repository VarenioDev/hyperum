yarn-error.log*

# ─── Переменные окружения ──────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ─── Данные (персональные данные учеников!) ────────
data/*
!data/.gitkeep

# ─── Бэкапы и дампы ────────────────────────────────
